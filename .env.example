# Безопасный шаблон. Реальные secrets сюда не коммитить.
# APP_ENV: development | test | staging | production
BAKUNITY_APP_NAME=Bakunity Infra
BAKUNITY_APP_ENV=development
BAKUNITY_LOG_LEVEL=INFO
BAKUNITY_REQUEST_ID_HEADER=X-Request-ID

# Нужен только процессу Telegram client. Не коммитить реальное значение.
BAKUNITY_TELEGRAM_BOT_TOKEN=
